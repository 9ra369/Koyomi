# Dependencies
node_modules/

# App data (local, per-machine — see data/.gitkeep)
data/*.json
data/*.bak
data/*.tmp

# Build output (build/ itself is NOT ignored — it holds tracked icon
# resources such as build/icon.ico; electron-builder's actual output goes
# to dist/ or release/, not build/)
dist/
out/
release/

# Electron
*.exe
*.dmg
*.AppImage

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
